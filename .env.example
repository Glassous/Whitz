# ===== PostgreSQL =====
POSTGRES_USER=whitz
POSTGRES_PASSWORD=whitz_dev_password
POSTGRES_DB=whitz

# ===== 安全密钥（生成：openssl rand -hex 32）=====
JWT_SECRET=please-change-me
# Hermes 默认 profile 的 API Server key（仅管理/健康检查用；每个用户 profile 有独立 key）
HERMES_API_SERVER_KEY=please-change-me

# ===== LLM（自定义 OpenAI 兼容端点，平台统一 Key）=====
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name

# ===== 可选：web_search 增强（不填则用内置 DuckDuckGo skill 兜底）=====
SEARCH_API_KEY=

# ===== 首个管理员（startup 时自动创建）=====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=please-change-me

# ===== CORS（前端开发服务器地址）=====
CORS_ORIGINS=http://localhost:5173