{
  "name": "whitz-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Whitz desktop client for Windows",
  "main": "./out/main/index.js",
  "author": "Whitz",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icon": "node scripts/build-icon.mjs",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "electron-vite build && node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "dompurify": "^3.2.4",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.6.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.3.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
