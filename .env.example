# ===== PostgreSQL =====
POSTGRES_USER=whitz
POSTGRES_PASSWORD=whitz_dev_password
POSTGRES_DB=whitz

# ===== 安全密钥（生成：openssl rand -hex 32）=====
JWT_SECRET=please-change-me
# Server 与 Agent Control API (agent-api) 之间的内部鉴权密钥（X-Agent-Token）
AGENT_INTERNAL_TOKEN=please-change-me

# ===== 应用数据目录（头像、工作区临时产物等共享卷路径）=====
APP_DATA_DIR=/app-data

# ===== LLM（自定义 OpenAI 兼容端点，平台统一 Key）=====
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name
# 当前模型是否支持视觉看图（true 时 Agent 会将图片文件以原生多模态方式传给模型）
LLM_SUPPORTS_VISION=true

# ===== 可选：多模型路由（留空则自动回退到主模型 LLM_*）=====
# 快速模型（用于简单对话、标题生成、记忆提取等轻量任务）
LLM_FAST_BASE_URL=
LLM_FAST_API_KEY=
LLM_FAST_MODEL=
# 深度推理模型（用于复杂规划、代码/分析等高阶任务）
LLM_REASONING_BASE_URL=
LLM_REASONING_API_KEY=
LLM_REASONING_MODEL=
# 视觉模型（用于图像理解，留空回退主模型）
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
# 思考模式自主决策：auto（AI 自主决策）| enabled（强制开启）| disabled（强制关闭）
LLM_THINKING_MODE=auto
# 思考参数协议：auto | deepseek | qwen | openai | none
LLM_THINKING_PARAM_STYLE=auto
LLM_ADAPTIVE_PROBE_ENABLED=true

# ===== 向量化 Embedding（OpenAI 兼容 /v1/embeddings，用于文件、对话轮次、旁聊摘要与长期记忆的 pgvector 向量检索）=====
# 注意：DeepSeek 官方接口暂不提供 /v1/embeddings，请填写第三方兼容端点（如硅基流动、阿里云百炼、OpenAI、智谱等）
# 留空时不会写入假向量，将自动平滑降级为 PostgreSQL pg_trgm 中文三元组 + FTS 混合检索
# 示例（硅基流动 SiliconFlow）: https://api.siliconflow.cn/v1  模型: BAAI/bge-m3（支持 1024，将自动对齐至 1536）或 Qwen/Qwen3-Embedding-0.6B
# 示例（阿里云百炼 DashScope）: https://dashscope.aliyuncs.com/compatible-mode/v1  模型: text-embedding-v3
# 示例（OpenAI）: https://api.openai.com/v1  模型: text-embedding-3-small
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_MODEL=BAAI/bge-m3
# 数据库 pgvector 列维度（默认 1536；若模型输出不同维度会自动通过 API dimensions 协商或标准化对齐）
EMBEDDING_DIMENSIONS=1536
# 单次批量向量化上限（阿里云百炼 text-embedding-v3/v4 限制每批 <= 10，默认 10 通用兼容各大厂商）
EMBEDDING_BATCH_SIZE=10
# Redis 向量缓存 TTL（秒，相同文本/查询直接命中缓存免重复计费）
EMBEDDING_CACHE_TTL_SECONDS=86400

# ===== 可选：Stage-2 Reranker 重排服务（自动兼容阿里云 DashScope 原生协议 & OpenAI/Jina/硅基流动标准协议）=====
# 留空则跳过二阶段重排，仅使用 RRF + 相关性阈值 + MMR 多样性去重
# 示例（阿里云百炼/Maas）: RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank  RERANK_MODEL=qwen3.7-text-rerank
# 示例（硅基流动）: RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank  RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 示例（Jina）: RERANK_BASE_URL=https://api.jina.ai/v1/rerank  RERANK_MODEL=jina-reranker-v2-base-multilingual
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TOP_N=8

# ===== 可选：代码执行沙箱（disabled | docker | e2b）=====
# - disabled: 禁用 execute_code 沙箱执行
# - docker: 使用本地 Docker 容器隔离执行（--network=none --read-only --memory=256m）
# - e2b: 使用 E2B 云端沙箱执行（需配置 E2B_API_KEY）
SANDBOX_MODE=disabled
E2B_API_KEY=

# ===== 可选：LangSmith 可观测性与评估 =====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=whitz
LANGSMITH_ENDPOINT=

# ===== 可选：web_search 增强（支持博查国内快速搜索 + Tavily 海外深度搜索并行；均不填则用内置 DuckDuckGo 检索兜底）=====
SEARCH_API_KEY=
BOCHA_API_KEY=

# ===== 首个管理员（startup 时自动创建）=====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=please-change-me

# ===== 运行环境 =====
APP_ENV=production
# 正式 HTTPS 部署后设为 true（Cookie 仅通过 HTTPS 发送）
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# 允许的 Host（用 1Panel 绑定域名后填写你的域名，多个用逗号分隔；* 表示不限制）
ALLOWED_HOSTS=*

# ===== 登录与会话 =====
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=15

# ===== 资源限制与多端实时同步 =====
MAX_CONCURRENT_RUNS=4
MAX_CONCURRENT_RUNS_PER_USER=2
# 多端/多标签并发 SSE 订阅上限（含实时状态同步流）
MAX_SSE_STREAMS=32
MAX_SSE_STREAMS_PER_USER=8
# 单次 Agent 运行最大时长（秒，与 Pro 档位对齐）
RUN_MAX_SECONDS=1200
CHAT_RATE_PER_MINUTE=30

# ===== 积分与会员 =====
# 1 积分 = TOKENS_PER_CREDIT 个 token；档位额度（Free/Plus/Pro）在 app/services/membership.py 中定义
TOKENS_PER_CREDIT=5000
MEMBERSHIP_DEFAULT_DAYS=30
# 对话票据是否绑定客户端 IP（1Panel 转发后需确保真实 IP 解析正确，否则保持 false）
STRICT_TICKET_IP=false
AUDIT_ENABLED=true

# 1Panel/Nginx 反向代理所在主机地址；同机部署保持 127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# ===== CORS（前端开发服务器地址）=====
CORS_ORIGINS=http://localhost:5173

# ===== SMTP 邮件服务（默认适配 QQ 邮箱：开启 POP3/SMTP 后填写 QQ 邮箱与 16 位授权码）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# QQ 邮箱要求发件人与 SMTP_USERNAME 一致，留空则自动使用 SMTP_USERNAME
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Whitz
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# ===== 腾讯云 COS（文件工作区直传，流式签名不经服务器中转）=====
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 可选：自定义访问域名 / CDN / 全球加速域名（留空默认 <bucket>.cos.<region>.myqcloud.com）
COS_PUBLIC_HOST=
# 存储前缀（多环境隔离）
COS_KEY_PREFIX=whitz/uploads
# 是否启用 STS 临时凭证（GetFederationToken，默认 false 使用主签名生成限定时长预签名 URL）
COS_USE_STS=false
COS_STS_DURATION_SECONDS=900
COS_UPLOAD_EXPIRES_SECONDS=600
COS_DOWNLOAD_EXPIRES_SECONDS=300
# 可选：已开通腾讯云数据万象时的图片缩放参数（如 imageMogr2/thumbnail/360x）；留空则缩略图复用短时 inline 预签名 URL
COS_IMAGE_THUMB_QUERY=
# 未完成上传（pending）文件记录的保留秒数，超时后自动清理并释放文件配额
PENDING_FILE_TTL_SECONDS=1800
FILE_MAX_SIZE_MB=20
MAX_FILES_PER_CONVERSATION=20

# ===== Agent 内部 MCP 服务地址（供 agent-worker 访问 server 内部 MCP 工具）=====
INTERNAL_MCP_BASE_URL=http://server:8000

# ===== 桌面端（Whitz Work / 内置模型）=====
# 允许的桌面来源（Electron 自定义协议 + 开发服务器）
DESKTOP_ORIGINS=app://whitz,http://localhost:5174
# Work 模式开关；关闭后桌面端入口隐藏且本地运行时拒绝启动
DESKTOP_WORK_MODE_ENABLED=true
DESKTOP_WORK_DISABLED_REASON=
DESKTOP_MIN_APP_VERSION=0.1.0
DESKTOP_LATEST_APP_VERSION=
DESKTOP_POLICY_TTL_MINUTES=360
# 生成：python server/scripts/gen_desktop_policy_key.py
DESKTOP_POLICY_PRIVATE_KEY=
DESKTOP_POLICY_KEY_ID=desktop-1
# 内置模型（OpenAI 兼容代理）：与网页共用 LLM_* 上游与额度
DESKTOP_LLM_MODEL_ALIAS=whitz-default
# 代理转发给上游的真实模型名；留空则复用 LLM_MODEL
DESKTOP_LLM_UPSTREAM_MODEL=
DESKTOP_LLM_MAX_TOKENS=8192
DESKTOP_LLM_BASE_URL=
DESKTOP_LLM_REQUEST_TIMEOUT_SECONDS=300